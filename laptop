#!/bin/sh

fancy_echo() {
  local fmt="$1"
  shift

  # shellcheck disable=SC2059
  printf "\n$fmt\n" "$@"
}

append_to_zshrc() {
  local text="$1" zshrc
  local skip_new_line="${2:-0}"

  zshrc="$HOME/.zshrc"

  if ! grep -Fqs "$text" "$zshrc"; then
    if [ "$skip_new_line" -eq 1 ]; then
      printf "%s\n" "$text" >>"$zshrc"
    else
      printf "\n%s\n" "$text" >>"$zshrc"
    fi
  fi
}

# shellcheck disable=SC2154
trap 'ret=$?; test $ret -ne 0 && printf "failed\n\n" >&2; exit $ret' EXIT

set -e

if [ ! -d "$HOME/.bin/" ]; then
  mkdir "$HOME/.bin"
fi

if [ ! -f "$HOME/.zshrc" ]; then
  touch "$HOME/.zshrc"
fi

# shellcheck disable=SC2016
append_to_zshrc 'export PATH="$HOME/.bin:$PATH"'

# Determine Homebrew prefix
arch="$(uname -m)"
if [ "$arch" = "arm64" ]; then
  HOMEBREW_PREFIX="/opt/homebrew"
else
  HOMEBREW_PREFIX="/usr/local"
fi

if [ -d "$HOMEBREW_PREFIX" ]; then
  if ! [ -r "$HOMEBREW_PREFIX" ]; then
    sudo chown -R "$LOGNAME:admin" /usr/local
  fi
else
  sudo mkdir "$HOMEBREW_PREFIX"
  sudo chflags norestricted "$HOMEBREW_PREFIX"
  sudo chown -R "$LOGNAME:admin" "$HOMEBREW_PREFIX"
fi

case "$SHELL" in
*/zsh) : ;;
*)
  fancy_echo "Changing your shell to zsh ..."
  chsh -s "$(which zsh)"
  ;;
esac

gem_install_or_update() {
  if mise exec -- gem list "$1" --installed >/dev/null; then
    mise exec -- gem update "$@"
  else
    mise exec -- gem install "$@"
  fi
}

brew="$(command -v brew || true)"
if [ -z "$brew" ]; then
  brew="$HOMEBREW_PREFIX/bin/brew"
fi

if [ ! -x "$brew" ]; then
  fancy_echo "Installing Homebrew ..."
  /bin/bash -c \
    "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
fi

# Initialize this setup process even when Homebrew was already installed.
eval "$("$brew" shellenv sh)"

# Dotfiles load this after their own PATH setup, and rcup does not replace it.
brew_init="eval \"\$(\"$brew\" shellenv zsh)\""
if ! grep -Fqs "$brew_init" "$HOME/.zshrc.local"; then
  printf '\n%s\n' "$brew_init" >>"$HOME/.zshrc.local"
fi

if brew list | grep -Fq brew-cask; then
  fancy_echo "Uninstalling old Homebrew-Cask ..."
  brew uninstall --force brew-cask
fi

fancy_echo "Setting up dotfiles ..."

if [ ! -d "$HOME/.dotfiles/" ]; then
  git clone git@github.com:ianagne/dotfiles.git $HOME/.dotfiles
fi

fancy_echo "Updating Homebrew formulae ..."
brew update
brew bundle --file="$HOME/.dotfiles/Brewfile"

# Load the repository's copy/exclude rules even before ~/.rcrc exists.
RCRC="$HOME/.dotfiles/rcrc" rcup

fancy_echo "Symlinking neovim configuration ..."

mkdir -p ${XDG_CONFIG_HOME:=$HOME/.config}
if [ ! -L "$XDG_CONFIG_HOME/nvim" ]; then
  ln -s $HOME/.lua $XDG_CONFIG_HOME/nvim
fi

if [ ! -e "$XDG_CONFIG_HOME/nvim/init.lua" ]; then
  ln -s $HOME/.init.lua $XDG_CONFIG_HOME/nvim/init.lua
fi

fancy_echo "Configuring mise version manager..."
# The dotfiles Brewfile installs mise. Run from HOME so the caller's project
# configuration cannot select runtimes for machine setup.
cd "$HOME"

# Preserve asdf's legacy_version_file behavior without managing mise's writable
# global tool configuration through rcm.
for language in ruby python node elixir; do
  mise settings add idiomatic_version_file_enable_tools "$language"
done

fancy_echo "Installing latest Ruby..."
mise use --global --pin ruby@latest
mise exec -- gem update --system
gem_install_or_update "bundler"
number_of_cores=$(sysctl -n hw.ncpu)
mise exec -- bundle config set --global jobs $((number_of_cores - 1))

fancy_echo "Installing latest Erlang..."
mise use --global --pin erlang@latest

fancy_echo "Installing latest Elixir..."
mise use --global --pin elixir@latest

fancy_echo "Installing latest Node.js..."
mise use --global --pin node@latest

fancy_echo "Installing latest Bun..."
curl -fsSL https://bun.sh/install | bash

# Install npm global packages

mise exec -- npm install -g agent-browser # headless browser automation CLI for AI agents
